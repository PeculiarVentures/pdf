{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noErrorTruncation": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@peculiar/pdf-core": ["./packages/core/src"],
      "@peculiar/pdf-cli": ["./packages/cli/src"],
      "@peculiar/pdf-doc": ["./packages/doc/src"],
      "@peculiar/pdf-font": ["./packages/font/src"],
      "@peculiar/pdf-copy": ["./packages/copy/src"],
      "@peculiar/pdf-form-json": ["./packages/form-json/src"],
      "@peculiar/pdf-repair": ["./packages/repair/src"],
      "@peculiar/pdf-tests": ["./packages/tests/src"]
    }
  },
  "include": ["packages/*/src", "packages/font/scripts", "*.config.ts"]
}
