  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@peculiar/webcrypto": "^1.4.3",
    "@peculiar/x509": "^1.12.3",
    "@types/node": "^24.0.0",
    "@types/pako": "^2.0.0",
    "@types/pvutils": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "canvas": "^3.2.3",
